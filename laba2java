public class laba2 {
    public static void main(String[] args) {
        int rows = 5;          // количество строк
        int startStars = 10;   // количество звездочек в первой строке

        for (int i = 0; i < rows; i++) {
            // Печать начальных пробелов (сдвиг вправо)
            for (int s = 0; s < i * 2; s++) {
                System.out.print(" ");
            }
            // Печать звездочек через пробел
            for (int j = 0; j < startStars - i; j++) {
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
